    <script>
        // Set current date and year
        document.addEventListener('DOMContentLoaded', function() {
            const now = new Date();
            const formattedDate = now.toISOString().split('T')[0];
            const displayDate = now.toLocaleDateString('en-US', { 
                weekday: 'long', 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            });
            
            // Set main date displays
            document.getElementById('current-date').textContent = displayDate;
            document.getElementById('current-year').textContent = now.getFullYear();
            
            // Set last modified dates (simulating recent updates)
            const lastModDates = document.querySelectorAll('.lastmod');
            lastModDates.forEach(element => {
                const randomDays = Math.floor(Math.random() * 7); // 0-6 days ago
                const modDate = new Date(now);
                modDate.setDate(modDate.getDate() - randomDays);
                element.textContent = modDate.toISOString().split('T')[0];
            });
            
            // Set XML lastmod dates
            document.getElementById('xml-lastmod-home').textContent = formattedDate;
            document.getElementById('xml-lastmod-powerball').textContent = formattedDate;
            document.getElementById('xml-lastmod-mega').textContent = formattedDate;
            
            // Download button functionality
            document.getElementById('download-xml').addEventListener('click', function(e) {
                e.preventDefault();
                alert('XML sitemap download would be triggered here. In a real implementation, this would generate and download the XML file.');
